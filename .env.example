# iiko Cloud API credentials for the guarded live contour.
# Copy to .env (mode 0600, owned by you) and fill real values.
# private/profiles/*.toml reference these names only; values live in .env.

# === SHARED: developer portal application (public-api.iikoweb.ru/portal) ===
IIKO_APP_ID=
IIKO_CLIENT_SECRET=

# === READ environment (profile: amato) ===
IIKO_API_KEY=
IIKO_TEST_ORGANIZATION_ID=
IIKO_TEST_TERMINAL_GROUP_ID=
IIKO_TEST_EXTERNAL_MENU_ID=
# Optional: only for a write-enabled read profile (allow_write=true).
# IIKO_TEST_WRITE_PRODUCT_ID=

# === WRITE environment (profile: write-server) ===
IIKO_WRITE_API_KEY=
IIKO_WRITE_ORGANIZATION_ID=
IIKO_WRITE_TERMINAL_GROUP_ID=
IIKO_WRITE_EXTERNAL_MENU_ID=
IIKO_WRITE_PRODUCT_ID=

# === RETIRED ===
# IIKO_API_KEY_2 is not read by the contour: alternate logins are forbidden,
# including after a 429.
